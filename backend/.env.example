APP_NAME=AlphaPilot
VERSION=1.0.0

DEBUG=true
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ADMIN_TOOLS_ENABLED=false
DAILY_MARKET_SYNC_ENABLED=false
AI_COPILOT_ENABLED=true
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
OLLAMA_TIMEOUT_SECONDS=30

DATABASE_URL=postgresql+asyncpg://alphapilot:alphapilot@localhost:5432/alphapilot
TEST_DATABASE_URL=postgresql+psycopg://alphapilot:alphapilot@localhost:5432/alphapilot_test

REDIS_URL=redis://localhost:6379

POLYGON_API_KEY=your_api_key_here
FINNHUB_API_KEY=your_api_key_here
ADANOS_API_KEY=

ALPACA_API_KEY=your_api_key_here
ALPACA_SECRET_KEY=your_secret_key_here
ALPACA_DATA_FEED=iex
OPENAI_API_KEY=

# Hosted News classifier (Google Gemini structured output). Keep secrets local.
NEWS_AI_CLASSIFIER_ENABLED=true
NEWS_AI_CLASSIFIER_PROVIDER=hosted
NEWS_AI_CLASSIFIER_API_KEY=
NEWS_AI_CLASSIFIER_BASE_URL=https://generativelanguage.googleapis.com/v1beta
NEWS_AI_CLASSIFIER_MODEL=gemini-3.5-flash-lite
NEWS_AI_CLASSIFIER_TIMEOUT_SECONDS=20
NEWS_AI_CLASSIFIER_MIN_CONFIDENCE=0.75
NEWS_AI_CLASSIFIER_VERSION=news-financial-impact-v1
NEWS_AI_CLASSIFIER_MAX_ATTEMPTS_PER_REFRESH=10
NEWS_AI_CLASSIFIER_DELAY_SECONDS=0.25
NEWS_COVERAGE_FRESH_HOURS=24
OLLAMA_NEWS_FALLBACK_ENABLED=false

WIKIMEDIA_USER_AGENT=AlphaPilotBot/0.1 (your-email@example.com)

ADMIN_TOOLS_ENABLED=true

# Deterministic in-app Operations incident evaluation. No external notifications.
OPERATIONS_MONITOR_ENABLED=true
OPERATIONS_MONITOR_INTERVAL_SECONDS=300

# Durable operational email notifications. Disabled by default. Keep SMTP secrets local.
NOTIFICATIONS_ENABLED=false
NOTIFICATION_EMAIL_ENABLED=false
NOTIFICATION_EMAIL_TO=
NOTIFICATION_WORKER_INTERVAL_SECONDS=60
NOTIFICATION_CRITICAL_REMINDER_SECONDS=3600
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_DELIVERY_LEASE_SECONDS=300
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=15
NOTIFICATION_FROM_EMAIL=
